__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Judge response cache: large, machine-local, and regenerable.
evals/.cache/

# Ingested corpus and index: regenerable from `make ingest && make index`,
# and far too large for git. The document store is the reproducible artifact,
# not something to version.
corpus/

# Calibration files contain hand-entered labels -- keep the samples file, but
# not scratch exports.
evals/calibration/*.tmp.json

# Sweep output and the reproduce report: 1.4MB of per-question detail that
# `make sweep` and `make reproduce` regenerate in seconds. Committing them
# means carrying a snapshot that nothing checks -- and the point of
# scripts/reproduce.py is that the figures are checked, not archived. CI
# uploads them as build artifacts instead.
evals/results/sweep/
evals/results/reproduce.json

.env
.DS_Store
